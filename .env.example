# Turso (libSQL) cloud database used by api/ and lib/auth.js
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Initial superadmin account. On first sign-in this secret is accepted once,
# then the admin is required to choose their own four-digit PIN.
# Use a long random value (at least 6 characters). SUPERADMIN_BOOTSTRAP_SECRET
# is also accepted as an alias for SUPERADMIN_INITIAL_PIN.
SUPERADMIN_PHONE=+233XXXXXXXXX
SUPERADMIN_INITIAL_PIN=replace-with-a-long-random-bootstrap-secret
